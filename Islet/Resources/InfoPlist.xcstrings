    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Islet connects to T3 Code on your Macs to show active agents in the notch."
          }
        },
        "en-XA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "［Ïslët çøññëçts tø T3 Çødë øñ ÿøûr Måçs tø shøw åçtïvë ågëñts ïñ thë ñøtçh. ~~~~~~~~~~~~~~~~~~~~~~~~~~~］"
