    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Islet shows the name of the Wi-Fi network you join. macOS requires location access to read network names; deny this and Islet will simply say 'Wi-Fi connected'."
          }
        },
        "en-XA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "［Ïslët shøws thë ñåmë øf thë Wï-Fï ñëtwørk ÿøû jøïñ. måçØS rëqûïrës løçåtïøñ åççëss tø rëåd ñëtwørk ñåmës; dëñÿ thïs åñd Ïslët wïll sïmplÿ såÿ 'Wï-Fï çøññëçtëd'. ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~］"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
