        "en-XA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "［%@. Ëqûål-prïørïtÿ %@ ïtëms ûsë thëïr ståblë ïtëm ïdëñtïfïër. ~~~~~~~~~~~~~~~~~~~~~~］"
          }
        }
      }
    },
    "%@. Equal-priority items use a stable source order, which places %@ before %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. Equal-priority items use a stable source order, which places %2$@ before %3$@."
          }
        },
        "en-XA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "［%@. Ëqûål-prïørïtÿ ïtëms ûsë å ståblë søûrçë ørdër, whïçh plåçës %@ bëførë %@. ~~~~~~~~~~~~~~~~~~~~~~~~~~~~］"
          }
        }
      }
    },
    "%@. Equal-priority occurrences use their occurrence identifier as the final tie-break." : {
      "localizations" : {
        "en-XA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "［%@. Ëqûål-prïørïtÿ øççûrrëñçës ûsë thëïr øççûrrëñçë ïdëñtïfïër ås thë fïñål tïë-brëåk. ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~］"
