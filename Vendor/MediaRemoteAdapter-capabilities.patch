diff --git a/src/adapter/get.m b/src/adapter/get.m
index 7a582ee..e1d37ba 100644
--- a/src/adapter/get.m
+++ b/src/adapter/get.m
@@ -69,6 +69,34 @@ NSDictionary *internal_get(BOOL isTestMode) {
           dispatch_group_leave(group);
         });
 
+    // Seek capability. MediaRemote reports this independently of duration, so
+    // finite live windows and non-seekable streams are represented honestly.
+    if (g_mediaRemote.getSupportedCommands != nil &&
+        g_mediaRemote.commandInfoGetCommand != nil &&
+        g_mediaRemote.commandInfoGetEnabled != nil) {
+        __block NSNumber *supportsSeekingValue = nil;
+        dispatch_semaphore_t commandsReady = dispatch_semaphore_create(0);
+        g_mediaRemote.getSupportedCommands(
+            g_serialdispatchQueue, ^(NSArray *commands) {
+              BOOL supportsSeeking = NO;
+              for (id commandInfo in commands) {
+                  if (g_mediaRemote.commandInfoGetCommand(commandInfo) ==
+                          kMRSeekToPlaybackPosition &&
+                      g_mediaRemote.commandInfoGetEnabled(commandInfo)) {
+                      supportsSeeking = YES;
+                      break;
+                  }
+              }
+              supportsSeekingValue = @(supportsSeeking);
+              dispatch_semaphore_signal(commandsReady);
+            });
+        dispatch_time_t commandTimeout =
+            dispatch_time(DISPATCH_TIME_NOW, 250 * NSEC_PER_MSEC);
+        if (dispatch_semaphore_wait(commandsReady, commandTimeout) == 0) {
+            liveData[kMRASupportsSeeking] = supportsSeekingValue;
+        }
+    }
+
     dispatch_group_enter(group);
     g_mediaRemote.getNowPlayingInfo(g_serialdispatchQueue, ^(
                                         NSDictionary *information) {
